# Copy into your deployment's environment settings only after provisioning real business details.
# Never commit .env.local or real credentials to Git.

# Required for staff sessions. Generate with a cryptographically secure random generator.
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters-long

# Required to bootstrap a local administrator. Generate a scrypt hash with:
# read -s -p "Admin password: " ADMIN_PASSWORD; echo
# ADMIN_PASSWORD_HASH="$(printf '%s' "$ADMIN_PASSWORD" | node scripts/hash-password.mjs)"
# unset ADMIN_PASSWORD
ADMIN_EMAIL=admin@your-company.example
ADMIN_PASSWORD_HASH=replace-with-scrypt-hash-from-script
ADMIN_NAME=Administrator
ADMIN_PHONE=

# Actual registered entity data. Leave unset until verified against registration/bank records.
VILA_LEGAL_ENTITY_NAME=
VILA_TRADE_NAME=
VILA_GSTIN=
VILA_PAN=
VILA_CIN=
VILA_STATE_CODE=
VILA_STATE_NAME=
VILA_ADDRESS_LINE1=
VILA_ADDRESS_LINE2=
VILA_CITY=
VILA_PINCODE=
VILA_PHONE=
VILA_BILLING_EMAIL=
VILA_SUPPORT_EMAIL=

# Verified beneficiary details only. Do not use guessed/sample bank or UPI values.
VILA_BANK_NAME=
VILA_BANK_BRANCH=
VILA_BANK_ACCOUNT_NAME=
VILA_BANK_BENEFICIARY_NAME=
VILA_BANK_ACCOUNT_NUMBER=
VILA_BANK_IFSC=
VILA_UPI_VPA=
VILA_UPI_PAYEE_NAME=

# Email delivery is preview-only without a provider key.
RESEND_API_KEY=

# Gateway settings are not sufficient on their own to enable payment confirmation.
# Collection remains intentionally disabled until persistent intent mapping and signed
# provider webhook reconciliation are implemented and tested.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_API_SECRET=
CASHFREE_ENV=SANDBOX

# IMPORTANT: there is currently no production database adapter in this branch.
# Do not deploy this branch expecting DATABASE_URL alone to enable persistence.
